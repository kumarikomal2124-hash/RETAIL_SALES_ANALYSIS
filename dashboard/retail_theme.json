{
  "name": "Retail Shop Analysis",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "good": "#2a78d6",
  "neutral": "#f0efec",
  "bad": "#e34948",
  "maximum": "#104281",
  "center": "#f0efec",
  "minimum": "#e34948",
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "header":  { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514e" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e4e3df" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0b0b0b" } }, "alignment": "left" }],
        "visualHeader": [{ "show": true }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#f4f3f0" } }, "transparency": 0 }] }
    }
  }
}
